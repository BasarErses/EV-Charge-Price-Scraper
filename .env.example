# AI provider: claude | gemini | ollama (ollama = local, no API key)
AI_PROVIDER=ollama

# Claude (Anthropic) - https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini (Google AI) - https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local LLM, no API key) - https://ollama.com
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Optional: links file path (default: links copy.txt)
# LINKS_FILE=links copy.txt
